#!/usr/bin/env python3
"""Mock IronCore metaldata service for local cloud-init development.

Serves a metadata JSON document at /v1/ with the same contract as the real
metaldata service:

    - requires the header: Metadata-Flavor: IronCore Metal
    - returns e.g. {"server-name": ..., "user-data": {"cloud-init": ...}}

If a document file is given, it is re-read on every request so edits take
effect immediately, without restarting the server. Without a file a small
default document is served.

Typical usage (see mkosi.profiles/cloud-init/README.md for the full loop):

    bin/metaldata-mock /tmp/metaldata.json &
    # point the VM at it (host is 10.0.2.2 in QEMU user networking):
    #   datasource:
    #     IronCore:
    #       metadata_url: "http://10.0.2.2:8080/v1/"
"""

import argparse
import json
import logging
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

DEFAULT_DOCUMENT = {
    "server-name": "dev-vm",
    "user-data": {
        "cloud-init": (
            "#cloud-config\n"
            "write_files:\n"
            "  - path: /etc/motd\n"
            "    content: hello from ironcore mock metaldata\n"
            "runcmd:\n"
            "  - touch /var/log/cloud-init-mock-ran\n"
        )
    },
}


def run(document_path, port, header_required):
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path.rstrip("/") not in ("/v1", ""):
                self.send_error(404)
                return
            if (
                header_required
                and self.headers.get("Metadata-Flavor") != "IronCore Metal"
            ):
                self.send_error(403, "missing Metadata-Flavor header")
                return

            if document_path:
                try:
                    with open(document_path, "rb") as f:
                        body = f.read()
                except OSError as e:
                    self.send_error(500, f"cannot read document: {e}")
                    return
            else:
                body = json.dumps(DEFAULT_DOCUMENT).encode()

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, fmt, *args):
            logging.info("%s - %s", self.address_string(), fmt % args)

    logging.basicConfig(
        level=logging.INFO, format="metaldata-mock: %(message)s"
    )
    logging.info("listening on :%d, document: %s", port, document_path or "built-in default")
    logging.info("from a QEMU guest use: http://10.0.2.2:%d/v1/", port)
    HTTPServer(("0.0.0.0", port), Handler).serve_forever()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "document",
        nargs="?",
        help="metadata JSON file, re-read on every request "
        "(default: built-in demo document)",
    )
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument(
        "--no-header-check",
        action="store_true",
        help="don't require the Metadata-Flavor header (for curl debugging)",
    )
    args = parser.parse_args()
    try:
        run(args.document, args.port, not args.no_header_check)
    except KeyboardInterrupt:
        sys.exit(0)


if __name__ == "__main__":
    main()

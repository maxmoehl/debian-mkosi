[Unit]
Description=Generate SSH host keys on first boot
# The image ships with no host keys (RemoveFiles in mkosi.conf); openssh-server
# generates them via its postinst at build time, which mkosi then deletes. The
# ssh.service unit has no ssh-keygen -A in ExecStartPre, so nothing regenerates
# them at runtime — generate them here, once, before ssh starts.
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
Before=ssh.socket ssh.service

[Service]
Type=oneshot
ExecStart=ssh-keygen -A
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
